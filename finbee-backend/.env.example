# Copy this file to .env and fill in real values. Never commit .env itself.

APP_NAME=FinBee Backend
ENV=development
DEBUG=True

# MongoDB Atlas — get this from Atlas > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=financial_planning_db

# Google OAuth — from Google Cloud Console > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# AI provider (swap without code changes)
AI_PROVIDER=groq
AI_MODEL=
AI_API_KEY=

# CORS — your frontend dev server
FRONTEND_ORIGIN=http://localhost:5173
